PORT=4000
NODE_ENV=development

# Tên miền hệ thống
FRONTEND_URL=https://your-frontend-domain.com
ALLOWED_ORIGINS=https://your-frontend-domain.com,http://localhost:3000,http://localhost:5173

# 1. Supabase PostgreSQL Database (Backend độc quyền truy cập)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Cloudflare R2 Object Storage
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_DOMAIN=https://your-media-domain.com

# 3. SePay (VietQR Tự động)
SEPAY_BANK_NAME=your-bank-name
SEPAY_BANK_ACCOUNT=your-bank-account-number
SEPAY_ACCOUNT_HOLDER=your-bank-account-holder
SEPAY_WEBHOOK_SECRET=your-sepay-webhook-secret
ORDER_CODE_PREFIX=your-order-code-prefix

# 4. PayPal (Cổng thanh toán Quốc tế)
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_MODE=sandbox
USD_EXCHANGE_RATE=25000

# 5. Google Form 14 Entries tự động
GOOGLE_FORM_ACTION_URL=https://docs.google.com/forms/d/e/your-form-id/formResponse

# 6. Khóa bảo mật Admin API
ADMIN_API_SECRET=your-admin-secret-key
