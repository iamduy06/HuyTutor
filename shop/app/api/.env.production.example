# Cấu hình Production cho Render
NODE_ENV=production
PORT=4000
CORS_ORIGINS=https://your-frontend-domain.com

# 1. Database Supabase (Backend độc quyền truy cập qua Service Role Key)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Cloudflare R2 Storage
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_DOMAIN=https://your-media-domain.com

# 3. Cổng thanh toán SePay VietQR (IP Việt Nam) & PayPal (IP Quốc tế)
SEPAY_BANK_NAME=your-bank-name
SEPAY_BANK_ACCOUNT=your-bank-account-number
SEPAY_ACCOUNT_HOLDER=your-bank-account-holder
SEPAY_WEBHOOK_SECRET=your-production-sepay-webhook-secret
ORDER_CODE_PREFIX=your-order-code-prefix
PAYPAL_CLIENT_ID=your-production-paypal-client-id
PAYPAL_MODE=live
USD_EXCHANGE_RATE=25000

# 4. Google Form 14 Entries
GOOGLE_FORM_ACTION_URL=https://docs.google.com/forms/d/e/your-form-id/formResponse

# 5. Khóa bảo mật Admin API
ADMIN_API_SECRET=your-strong-admin-secret
